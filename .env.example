# Supabase credentials
# Get these from: supabase.com → Project Settings → API
#
# These values are embedded directly in index.html and admin.html
# (this is a static site with no build step — env vars are for reference only)

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJ...your-anon-key-here
